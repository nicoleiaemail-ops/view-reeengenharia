# Copie para .env e preencha. As chaves VITE_ ficam expostas no bundle do
# navegador por design — nunca coloque segredo de servidor aqui.

# ── Supabase ───────────────────────────────────────────────────────────────
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# ── Analytics ──────────────────────────────────────────────────────────────
# Sem estes dois IDs o site não carrega nenhum script de terceiro e todos os
# eventos viram no-op: o site funciona igual, mas continua cego. Preencher é o
# que destrava medir o funil (de onde vêm os leads, onde as pessoas desistem
# do formulário e do questionário, qual seção converte).
#
# GA4:     analytics.google.com → Admin → Fluxos de dados → ID de métrica
# Clarity: clarity.microsoft.com → Settings → Overview → Project ID
#
# Defina também na Vercel: Project → Settings → Environment Variables.
VITE_GA4_ID=
VITE_CLARITY_ID=
